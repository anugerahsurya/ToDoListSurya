# ============================================================
# APLIKASI MANAJEMEN KEGIATAN — Environment Variables
# ============================================================
# Salin file ini menjadi .env.local dan isi nilai yang diperlukan

# URL Google Apps Script Web App (setelah dideploy)
# Cara mendapatkan:
#   1. Buka Google Apps Script (script.google.com)
#   2. Deploy > New deployment > Web app
#   3. Execute as: Me, Access: Anyone
#   4. Copy URL dan tempel di sini
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
